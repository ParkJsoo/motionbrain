# Copy to /etc/motionbrain/perception.env on the Raspberry Pi.
# Do not commit real local secrets.

MOTIONBRAIN_REPO=/home/motionbrain/develop/arduino/motionbrain
MOTIONBRAIN_OPENCV_PYTHON=/home/motionbrain/.cache/motionbrain/opencv-venv/bin/python
MOTIONBRAIN_DISCOVERY=1
MOTIONBRAIN_DISCOVERY_PYTHON=/usr/bin/python3
MOTIONBRAIN_DISCOVERY_TIMEOUT=0.35
MOTIONBRAIN_DISCOVERY_WORKERS=64

# Prefer static DHCP reservations for real demos.
MOTIONBRAIN_CAMERA_URL=http://motionbrain-cam.local
MOTIONBRAIN_CAMERA_PROFILE=1
MOTIONBRAIN_CAMERA_FRAMESIZE=qvga
MOTIONBRAIN_CAMERA_QUALITY=4
MOTIONBRAIN_CAMERA_PROFILE_TIMEOUT=3.0

# Bind to localhost when only the dashboard/ROS2 bridge should consume this API.
# Use 0.0.0.0 only when another LAN machine must query the perception API directly.
MOTIONBRAIN_PERCEPTION_HOST=127.0.0.1
MOTIONBRAIN_PERCEPTION_PORT=8766
MOTIONBRAIN_PERCEPTION_TIMEOUT=2.0
MOTIONBRAIN_PERCEPTION_INTERVAL=1.0
MOTIONBRAIN_PERCEPTION_STALE_SECONDS=8.0
MOTIONBRAIN_DISPLAY_HOLD_SECONDS=2.5

MOTIONBRAIN_DETECTOR_MODE=object
MOTIONBRAIN_DETECT_COLOR=red
MOTIONBRAIN_ALIGN_DEADBAND=0.15

MOTIONBRAIN_OBJECT_BACKEND=opencv-dnn
MOTIONBRAIN_OBJECT_MODEL=/home/motionbrain/.cache/motionbrain/models/yolov5s.onnx
MOTIONBRAIN_OBJECT_LABELS=/home/motionbrain/develop/arduino/motionbrain/config/coco80.labels
MOTIONBRAIN_OBJECT_TARGET=cup
MOTIONBRAIN_OBJECT_TARGET_ALIASES=
MOTIONBRAIN_OBJECT_MIN_CONFIDENCE=0.25
MOTIONBRAIN_OBJECT_NMS_THRESHOLD=0.45
MOTIONBRAIN_OBJECT_INPUT_SIZE=640
MOTIONBRAIN_TARGET_POLICY=largest
MOTIONBRAIN_OPENCV_THREADS=1
