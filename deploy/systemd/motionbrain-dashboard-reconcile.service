[Unit]
Description=MotionBrain dashboard/perception device reconcile
Wants=network-online.target
After=network-online.target motionbrain-perception.service motionbrain-dashboard.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/motionbrain/reconcile_dashboard_services.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
TasksMax=128
MemoryMax=256M
LimitNOFILE=4096
