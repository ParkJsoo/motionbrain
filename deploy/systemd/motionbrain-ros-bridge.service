[Unit]
Description=MotionBrain ROS2 bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=motionbrain
WorkingDirectory=/home/motionbrain/develop/arduino/motionbrain/ros2_ws
EnvironmentFile=/etc/motionbrain/ros-bridge.env
ExecStart=/home/motionbrain/develop/arduino/motionbrain/tools/raspi/start_ros_bridge.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
TasksMax=256
MemoryMax=1024M
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
