# Copy to /etc/motionbrain/ros-bridge.env on the Raspberry Pi.
# Do not commit the real token.

ROS_DISTRO=jazzy
MOTIONBRAIN_REPO=/home/motionbrain/develop/arduino/motionbrain
MOTIONBRAIN_ROS_WS=/home/motionbrain/develop/arduino/motionbrain/ros2_ws
MOTIONBRAIN_DISCOVERY=1
MOTIONBRAIN_DISCOVERY_PYTHON=/usr/bin/python3
MOTIONBRAIN_DISCOVERY_TIMEOUT=0.35
MOTIONBRAIN_DISCOVERY_WORKERS=64

# Prefer static DHCP reservations for these values in real demos.
MOTIONBRAIN_HOST=motionbrain.local
MOTIONBRAIN_CAMERA_URL=http://motionbrain-cam.local
# Optional: route ROS2 camera detection through Pi perception service instead
# of letting the ROS2 bridge open another direct ESP32-CAM connection.
MOTIONBRAIN_PERCEPTION_URL=http://127.0.0.1:8766

MOTIONBRAIN_DETECT_COLOR=red
MOTIONBRAIN_POLL_INTERVAL=1.0
MOTIONBRAIN_HTTP_TIMEOUT=4.0
MOTIONBRAIN_EVENTS_LIMIT=8

# Real value must match the ESP32 command token provisioned in NVS.
MOTIONBRAIN_HTTP_TOKEN=CHANGE_ME_TO_LOCAL_CONTROLLER_TOKEN
