# Copy to /etc/motionbrain/ros-bridge.env on the Raspberry Pi.
# Do not commit the real token.

ROS_DISTRO=jazzy
MOTIONBRAIN_REPO=/home/motionbrain/develop/arduino/motionbrain
MOTIONBRAIN_ROS_WS=/home/motionbrain/develop/arduino/motionbrain/ros2_ws
MOTIONBRAIN_DISCOVERY=1
MOTIONBRAIN_DISCOVERY_PYTHON=/usr/bin/python3
MOTIONBRAIN_DISCOVERY_TIMEOUT=0.35
MOTIONBRAIN_DISCOVERY_WORKERS=64

# Prefer static DHCP reservations for these values in real demos.
MOTIONBRAIN_HOST=motionbrain.local
MOTIONBRAIN_CAMERA_URL=http://motionbrain-cam.local
# Optional: route ROS2 camera detection through Pi perception service instead
# of letting the ROS2 bridge open another direct ESP32-CAM connection.
MOTIONBRAIN_PERCEPTION_URL=http://127.0.0.1:8766

MOTIONBRAIN_DETECT_COLOR=red
MOTIONBRAIN_POLL_INTERVAL=1.0
MOTIONBRAIN_HTTP_TIMEOUT=4.0
MOTIONBRAIN_EVENTS_LIMIT=8

# The bridge always publishes status-derived estimates on the explicit topic.
# joint_states_output selects what it mirrors to /joint_states:
#   estimated: compatibility default
#   measured: calibrated fresh M4 shoulder feedback only
#   none: reserve /joint_states for ros2_control or another selected owner
MOTIONBRAIN_ENABLE_JOINT_STATE_BRIDGE=true
MOTIONBRAIN_JOINT_STATE_AUTOSTART=true
MOTIONBRAIN_JOINT_STATES_TOPIC=/joint_states
MOTIONBRAIN_ESTIMATED_JOINT_STATES_TOPIC=/motionbrain/estimated_joint_states
MOTIONBRAIN_JOINT_STATES_OUTPUT=estimated

# M4 AS5600 sensor-space degrees are not ROS joint radians. Keep calibration
# disabled until a supervised pose defines the sensor zero and direction.
MOTIONBRAIN_SHOULDER_FEEDBACK_CALIBRATION_ENABLED=false
MOTIONBRAIN_SHOULDER_SENSOR_ZERO_DEG=0.0
MOTIONBRAIN_SHOULDER_DIRECTION_SIGN=1
MOTIONBRAIN_SHOULDER_ROS_JOINT_ZERO_RAD=0.0
MOTIONBRAIN_KINEMATICS_AUTOSTART=true
MOTIONBRAIN_CONTROL_GUARD_AUTOSTART=true
MOTIONBRAIN_MISSION_SUPERVISOR_AUTOSTART=true

# Real value must match the ESP32 command token provisioned in NVS.
MOTIONBRAIN_HTTP_TOKEN=CHANGE_ME_TO_LOCAL_CONTROLLER_TOKEN
