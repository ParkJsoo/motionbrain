# Copy to /etc/motionbrain/dashboard.env on the Raspberry Pi.
# Do not commit the real controller token.

MOTIONBRAIN_REPO=/home/motionbrain/develop/arduino/motionbrain
MOTIONBRAIN_DASHBOARD_PYTHON=/usr/bin/python3
MOTIONBRAIN_DISCOVERY=1
MOTIONBRAIN_DISCOVERY_PYTHON=/usr/bin/python3
MOTIONBRAIN_DISCOVERY_TIMEOUT=0.35
MOTIONBRAIN_DISCOVERY_WORKERS=64

# Prefer static DHCP reservations for real demos.
MOTIONBRAIN_MOTION_HOST=motionbrain.local
MOTIONBRAIN_MOTION_PORT=80
MOTIONBRAIN_CAMERA_URL=http://motionbrain-cam.local
MOTIONBRAIN_CAMERA_PROFILE=1
MOTIONBRAIN_CAMERA_FRAMESIZE=qvga
MOTIONBRAIN_CAMERA_QUALITY=15
MOTIONBRAIN_CAMERA_PROFILE_TIMEOUT=3.0
MOTIONBRAIN_PERCEPTION_URL=http://127.0.0.1:8766

MOTIONBRAIN_DASHBOARD_HOST=0.0.0.0
MOTIONBRAIN_DASHBOARD_PORT=8765
MOTIONBRAIN_DASHBOARD_TIMEOUT=2.0
MOTIONBRAIN_EVENTS_LIMIT=12
MOTIONBRAIN_DETECT_COLOR=red

MOTIONBRAIN_ALIGN_NUDGE_MS=250
MOTIONBRAIN_ALIGN_PERCENT=25
MOTIONBRAIN_GRASP_TARGET_LABEL=cup
MOTIONBRAIN_GRASP_MIN_CONFIDENCE=0.5

# Real value must match the ESP32 command token provisioned in NVS.
MOTIONBRAIN_HTTP_TOKEN=CHANGE_ME_TO_LOCAL_CONTROLLER_TOKEN

# Optional stable local dashboard POST token. Leave blank to generate on restart.
MOTIONBRAIN_DASHBOARD_TOKEN=
