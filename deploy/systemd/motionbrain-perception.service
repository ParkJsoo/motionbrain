[Unit]
Description=MotionBrain Pi perception service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=motionbrain
WorkingDirectory=/home/motionbrain/develop/arduino/motionbrain
EnvironmentFile=/etc/motionbrain/perception.env
ExecStart=/home/motionbrain/develop/arduino/motionbrain/tools/raspi/start_perception_service.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
TasksMax=192
MemoryMax=1536M
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
