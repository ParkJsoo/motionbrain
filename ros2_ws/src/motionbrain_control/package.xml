<?xml version="1.0"?>
<package format="3">
  <name>motionbrain_control</name>
  <version>0.1.0</version>
  <description>C++ ROS2 control guard node for MotionBrain typed status and camera detection.</description>
  <maintainer email="ParkJsoo@users.noreply.github.com">Jeongsoo Park</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>motionbrain_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
