<?xml version="1.0"?>
<robot name="motionbrain">
  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="graphite">
        <color rgba="0.12 0.14 0.16 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0.09 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.18"/>
      </geometry>
      <material name="signal_blue">
        <color rgba="0.04 0.31 0.65 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.12 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.24 0.035 0.035"/>
      </geometry>
      <material name="motion_orange">
        <color rgba="0.9 0.36 0.08 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0.10 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.20 0.03 0.03"/>
      </geometry>
      <material name="steel">
        <color rgba="0.55 0.58 0.6 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.055 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.11 0.025 0.025"/>
      </geometry>
      <material name="dark_plastic">
        <color rgba="0.05 0.05 0.06 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.08 0.025"/>
      </geometry>
      <material name="search_light">
        <color rgba="1.0 0.86 0.18 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="gripper_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0.11 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7854" upper="0.7854" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.025"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.01 0.01 0.01 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.10 -0.08 0.12" rpy="0 0 -0.35"/>
  </joint>
</robot>
