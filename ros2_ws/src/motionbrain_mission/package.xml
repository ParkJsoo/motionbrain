<?xml version="1.0"?>
<package format="3">
  <name>motionbrain_mission</name>
  <version>0.1.0</version>
  <description>Lightweight mission supervisor for MotionBrain ROS2 demos.</description>
  <maintainer email="jeongsoopark@example.com">Jeongsu Park</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>motionbrain_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
