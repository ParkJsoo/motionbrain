+void traceBootStage(const char* stage) {
+  const bool integrity = heap_caps_check_integrity_all(true);
+  Serial.printf("BOOT_STAGE ms=%lu stage=%s core=%d heap=%lu largest=%lu minheap=%lu stack=%lu integrity=%d\n",
+                static_cast<unsigned long>(millis()), stage, xPortGetCoreID(),
+                static_cast<unsigned long>(ESP.getFreeHeap()),
+                static_cast<unsigned long>(heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL)),
+                static_cast<unsigned long>(ESP.getMinFreeHeap()),
+                static_cast<unsigned long>(uxTaskGetStackHighWaterMark(nullptr)), integrity);
+  Serial.flush();
+}
